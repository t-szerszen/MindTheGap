# Ścieżka, pod którą stoi aplikacja. Lokalnie zostaw puste.
# Na GitHub Pages workflow ustawia to sam na /nazwa-repo/.
VITE_BASE=

# Konfiguracja aplikacji webowej z konsoli Firebase (Ustawienia projektu -> Twoje aplikacje).
# To nie są sekrety, bezpieczeństwo załatwiają reguły Firestore.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Adres workera z Cloudflare, który pośredniczy w DeepL, np. https://mind-the-gap.twoja-nazwa.workers.dev
VITE_TRANSLATE_API_URL=

# Przypomnienie push. Klucz publiczny VAPID (ten sam, co VAPID_PUBLIC_KEY w workerze), też nie jest sekretem.
# Bez niego sekcja "Przypomnienie" w ustawieniach się nie pokazuje.
VITE_VAPID_PUBLIC_KEY=
# Adres workera od powiadomień. Puste = ten sam co VITE_TRANSLATE_API_URL.
VITE_PUSH_API_URL=
