# Ścieżka, pod którą stoi aplikacja. Lokalnie zostaw puste.
# Na GitHub Pages workflow ustawia to sam na /nazwa-repo/.
VITE_BASE=

# Konfiguracja aplikacji webowej z konsoli Firebase (Ustawienia projektu -> Twoje aplikacje).
# To nie są sekrety, bezpieczeństwo załatwiają reguły Firestore.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Adres workera z Cloudflare, który pośredniczy w DeepL, np. https://mind-the-gap.twoja-nazwa.workers.dev
VITE_TRANSLATE_API_URL=
