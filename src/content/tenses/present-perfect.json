  "uses": [
    {
      "title_pl": "Doświadczenie życiowe (bez „kiedy”)",
      "explanation_pl": "Mówisz, że coś zdarzyło się (albo nie) kiedykolwiek w twoim życiu aż do teraz. Moment nie jest ważny, więc go nie podajesz. Typowe słowa: ever, never, before, once, twice.",
      "examples": [
        {
          "en": "I have never eaten sushi.",
          "pl": "Nigdy nie jadłem sushi."
        },
        {
          "en": "Have you ever been to Scotland?",
          "pl": "Byłeś kiedyś w Szkocji?"
        },
        {
          "en": "She has read this book three times.",
          "pl": "Czytała tę książkę trzy razy."
        }
      ]
    },
    {
      "title_pl": "Skutek widoczny teraz",
      "explanation_pl": "Czynność się skończyła, ale jej efekt jest ważny w chwili mówienia. Często z just, already i yet.",
      "examples": [
        {
          "en": "I've lost my keys, so I can't get in.",
          "pl": "Zgubiłem klucze, więc nie mogę wejść."
        },
        {
          "en": "She has just left — you've missed her.",
          "pl": "Właśnie wyszła — minąłeś się z nią."
        },
        {
          "en": "Have you finished your homework yet?",
          "pl": "Skończyłeś już pracę domową?"
        }
      ]
    }
  ],
