  "howToChoose": [
    {
      "step_pl": "sygnał",
      "text_pl": "Szukasz słów: ever, never, just, already, yet, so far, for, since. I sprawdzasz, czy w zdaniu NIE ma konkretnego momentu w przeszłości (yesterday, ago, in 2020)."
    },
    {
      "step_pl": "relacja w czasie",
      "text_pl": "Coś wydarzyło się wcześniej, ale patrzysz na to z perspektywy TERAZ: liczy się skutek, doświadczenie albo stan, który trwa do dziś."
    },
    {
      "step_pl": "forma",
      "text_pl": "have / has + V3. Przeczenie: haven't / hasn't + V3. Pytanie: Have / Has + podmiot + V3?"
    }
  ],
  "forms": {
    "active": {
      "affirmative": {
        "pattern": [
          {
            "text": "Subject",
            "role": "subject"
          },
          {
            "text": "have / has",
            "role": "aux"
          },
          {
            "text": "V3",
            "role": "verb"
          }
        ],
        "example": {
          "en": "She has finished her essay.",
          "pl": "Skończyła (już) rozprawkę."
        },
        "note_pl": "he / she / it → has, reszta → have. V3 to trzecia forma: regularne -ed (worked), nieregularne z tabeli (go → gone)."
